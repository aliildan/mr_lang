# mr_lang Framework Configuration
# Copy this file to .env and fill in the values you need.
# All variables are optional — sensible defaults are used.
# IMPORTANT: Do NOT put comments on the same line as values.

# --- Model Provider ---
# MR_LANG_DEFAULT_PROVIDER=ollama
# MR_LANG_DEFAULT_MODEL=llama3
# MR_LANG_OLLAMA_BASE_URL=http://127.0.0.1:11434
# MR_LANG_TEMPERATURE=0.7

# --- Workspace ---
# MR_LANG_WORKSPACE_DIR=./examples/workspaces/simple

# --- Memory ---
# Backend for conversation + long-term memory: memory (in-process, lost on restart), sqlite (recommended), postgres
# MR_LANG_MEMORY_BACKEND=sqlite
# MR_LANG_SQLITE_PATH=mr_lang.db
# MR_LANG_POSTGRES_URL=postgresql://user:pass@localhost:5432/mr_lang

# Enable agent memory tools (remember_fact, recall_facts, forget_fact)
# MR_LANG_MEMORY_ENABLED=true

# --- Embeddings (for semantic memory search) ---
# MR_LANG_EMBEDDING_PROVIDER=ollama
# MR_LANG_EMBEDDING_MODEL=nomic-embed-text

# --- Tool Safety ---
# Filesystem sandbox: comma-separated allowed paths (empty = allow all)
# MR_LANG_TOOLS_ALLOWED_PATHS=
# Shell command blocklist: comma-separated patterns
# MR_LANG_TOOLS_BLOCKED_COMMANDS=rm -rf /,mkfs,dd if=,:(){ :|:& };:

# --- LangSmith (optional cloud observability) ---
# MR_LANG_LANGSMITH_API_KEY=
# MR_LANG_LANGSMITH_TRACING=false
# MR_LANG_LANGSMITH_PROJECT=mr-lang

# --- MCP Server ---
# MR_LANG_HOST=127.0.0.1
# MR_LANG_PORT=8000

# --- Telegram Bot (fallback — prefer per-plugin [plugin.telegram] config) ---
# MR_LANG_TELEGRAM_BOT_TOKEN=
# Auth mode: open, allowlist, or invite
# MR_LANG_TELEGRAM_AUTH_MODE=invite
# Comma-separated Telegram user IDs
# MR_LANG_TELEGRAM_ADMIN_USER_IDS=
# MR_LANG_TELEGRAM_ALLOWED_USER_IDS=
# Comma-separated invite codes
# MR_LANG_TELEGRAM_INVITE_CODES=
# 0 = unlimited uses per code
# MR_LANG_TELEGRAM_MAX_USES_PER_CODE=0

# --- Logging ---
# MR_LANG_LOG_LEVEL=INFO

# --- Plugin Discovery (colon-separated paths) ---
# MR_LANG_PLUGINS=/path/to/plugin1:/path/to/plugin2
