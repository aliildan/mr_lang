# Copy to .env and fill in your values

# Model provider
MR_LANG_DEFAULT_PROVIDER=ollama
MR_LANG_DEFAULT_MODEL=llama3.1:8b
MR_LANG_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistent memory (survives restarts)
MR_LANG_MEMORY_BACKEND=sqlite

# Where Memo stores notes and tasks
# Default: ~/.local/share/memo
MEMO_DATA_DIR=

# Telegram bot (optional — run with: mr-lang telegram --plugin memo)
MEMO_TELEGRAM_TOKEN=
